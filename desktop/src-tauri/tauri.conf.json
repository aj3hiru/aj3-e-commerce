{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sri Andal Admin",
  "version": "1.0.0",
  "identifier": "in.co.sriandaltraders.admin",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Sri Andal Traders",
    "copyright": "Sri Andal Traders",
    "category": "Business",
    "shortDescription": "Sri Andal Admin",
    "longDescription": "Store admin for Sri Andal Traders: billing, orders, products, customers and everything in the website admin — also when the internet is down.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
