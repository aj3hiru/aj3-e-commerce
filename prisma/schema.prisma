// ════════════════════════════════════════════════════════════════════════
// EduMint24 — Prisma Schema
// Every field below was verified against actual INSERT/UPDATE/SELECT
// statements in the original PHP codebase (admin/ecommerce/*.php,
// shop/*.php, admin/*.php) — not guessed.
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// SYSTEM / AUTH
// ─────────────────────────────────────────────────────────────────────────

// Admin/staff accounts. Verified from: admin/user-manager.php
// INSERT INTO users (username, email, password_hash, role, permissions)
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          String   // e.g. "admin", "staff"
  permissions   Json     // nested JSON: { dashboard_access: true, ecommerce: { manage_products: true, ... }, blogs: {...}, ... }
                         // NOTE: dashboard_access is checked at LOGIN time (see login.php) — a user can
                         // exist without it and simply be denied entry to the admin panel entirely.
  status        String   @default("active") // "active" | "inactive" — checked on every protected page
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  activityLogs  ActivityLog[]
  posts         Post[]

  @@map("users")
}

// Written on nearly every admin mutation — implement as a shared
// audit-log utility called from every write operation.
model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  actionType  String   @map("action_type") // e.g. "ecom_product_create", "ecom_pos_sale"
  description String
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model AppConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("app_config")
}

// ─────────────────────────────────────────────────────────────────────────
// ECOMMERCE — CATALOG
// ─────────────────────────────────────────────────────────────────────────

model EcomCategory {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  image            String?
  metaKeywords     String?  @map("meta_keywords")
  metaDescription  String?  @map("meta_description") @db.Text
  status           String   @default("active")
  serial           Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at") // categories2 — see prisma/categories2.sql

  subcategories EcomSubcategory[]
  products      EcomProduct[]
  homeSections  EcomHomeSection[]
  homeSectionItems EcomHomeSectionItem[]
  coupons       EcomCoupon[]       @relation("CouponCategory")
  homeCategoryStrip EcomHomeCategoryStrip[]

  @@map("ecom_categories")
}

model EcomSubcategory {
  id         Int    @id @default(autoincrement())
  categoryId Int    @map("category_id")
  name       String
  slug       String @unique
  status     String @default("active")

  category EcomCategory  @relation(fields: [categoryId], references: [id])
  products EcomProduct[]
  coupons  EcomCoupon[]  @relation("CouponSubcategory")

  @@map("ecom_subcategories")
}

model EcomBrand {
  id        Int     @id @default(autoincrement())
  name      String
  slug      String  @unique
  logo      String?
  isPopular Boolean @default(false) @map("is_popular")
  status    String  @default("active")

  products EcomProduct[]

  @@map("ecom_brands")
}

// Verified from admin/ecommerce/add-product-form.php — full field list
// including conditional fields for each product_type.
model EcomProduct {
  id            Int      @id @default(autoincrement())
  categoryId    Int?     @map("category_id")
  subcategoryId Int?     @map("subcategory_id")
  brandId       Int?     @map("brand_id")
  name          String
  slug          String   @unique
  sku           String?
  hsnCode       String?  @map("hsn_code")
  barcode       String?  @unique // duplicate-barcode check enforced at app layer BEFORE insert (see business logic notes)
  productType   String   @map("product_type") // "physical" | "digital" | "license" | "affiliate"
  price         Decimal  @db.Decimal(10, 2)
  salePrice     Decimal? @map("sale_price") @db.Decimal(10, 2)
  gstRate       Decimal  @map("gst_rate") @db.Decimal(5, 2)
  stockQty      Int?     @map("stock_qty") // null for non-physical types
  // Sold-by unit label — "KG", "Gram", "Liter", "ml", "cm", "Meter", "Piece",
  // or any free text the admin types for a "Custom" unit. Null means the
  // product has no unit (sold as a plain countable item, the pre-existing
  // behavior for every product created before this field existed).
  unit          String?
  image         String?
  description   String?  @db.Text
  badgeTag      String   @default("none") @map("badge_tag") // "none" | "new" | "best" | "hot" | "featured"
  itemType      String   @default("normal") @map("item_type")
  status        String   @default("active") // "active" | "inactive"

  // conditional per product_type
  downloadLink  String? @map("download_link")  // only for "digital"
  licenseKey    String? @map("license_key")    // only for "license"
  affiliateUrl  String? @map("affiliate_url")  // only for "affiliate"

  isCampaign    Boolean @default(false) @map("is_campaign")
  campaignPrice Decimal? @map("campaign_price") @db.Decimal(10, 2)
  showOnHome    Boolean @default(false) @map("show_on_home")

  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  category    EcomCategory?    @relation(fields: [categoryId], references: [id])
  subcategory EcomSubcategory? @relation(fields: [subcategoryId], references: [id])
  brand       EcomBrand?       @relation(fields: [brandId], references: [id])
  images      EcomProductImage[]
  sizes       EcomProductSize[]
  specs       EcomProductSpec[]
  reviews     EcomProductReview[]
  orderItems  EcomOrderItem[]
  wishlists   EcomWishlist[]
  homeSectionItems EcomHomeSectionItem[]
  coupons     EcomCoupon[]     @relation("CouponProduct")

  @@map("ecom_products")
}

/// Sizes / Units for one product (e.g. 250 g / 500 g / 1 Kg), each with its
/// own MRP, optional selling price and optional stock. A product with no rows
/// here is a simple single-price product using EcomProduct.price / salePrice.
/// Added by /admin/ecommerce/add-product2.
model EcomProductSize {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  label     String   @db.VarChar(50)
  mrp       Decimal  @db.Decimal(10, 2)
  price     Decimal? @db.Decimal(10, 2) // selling price; null = sells at MRP
  stockQty  Int?     @map("stock_qty")   // null = not tracked per size
  isDefault Boolean  @default(false) @map("is_default")
  sortOrder Int      @default(0) @map("sort_order")

  product EcomProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("ecom_product_sizes")
}

/// Specifications shown as a bullet list on the product page, e.g.
/// "Material: Cotton". Added by /admin/ecommerce/add-product2.
model EcomProductSpec {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  name      String @db.VarChar(100)
  value     String @db.VarChar(255)
  sortOrder Int    @default(0) @map("sort_order")

  product EcomProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("ecom_product_specs")
}

model EcomProductImage {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  image     String
  sortOrder Int    @default(0) @map("sort_order")

  product EcomProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("ecom_product_images")
}

// Badge tags AND item types both live here, distinguished by tagGroup.
// Verified from admin/ecommerce/product-tags.php, add-brand-ajax.php, add-item-type-ajax.php
model EcomProductTag {
  id        Int     @id @default(autoincrement())
  label     String
  slug      String
  tagGroup  String  @map("tag_group") // "badge" | "item_type"
  color     String? // hex color for badge display, verified from products.php (only used for tag_group="badge")
  sortOrder Int     @default(0) @map("sort_order")
  status    String  @default("active")

  @@unique([slug, tagGroup])
  @@map("ecom_product_tags")
}

model EcomProductReview {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  customerName String   @map("customer_name") // denormalized at submit time, verified from product.php's INSERT
  rating       Int      // 1-5
  reviewText   String?  @map("review_text") @db.Text
  status       String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt    DateTime @default(now()) @map("created_at")

  // Added by /admin/ecommerce/product-reviews2. All three are optional and all
  // existing rows keep NULL, so nothing that reads reviews today is affected.
  // They let a review be tied to the customer and the order it came from, which
  // is what makes searching by phone number or order number possible.
  customerId    Int?    @map("customer_id")
  customerPhone String? @map("customer_phone") @db.VarChar(20)
  orderId       Int?    @map("order_id")

  product  EcomProduct    @relation(fields: [productId], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@map("ecom_product_reviews")
}

model EcomGstRate {
  id        Int     @id @default(autoincrement())
  label     String
  rate      Decimal @db.Decimal(5, 2)
  isDefault Boolean @default(false) @map("is_default")

  @@map("ecom_gst_rates")
}

// ─────────────────────────────────────────────────────────────────────────
// ECOMMERCE — CUSTOMERS / ORDERS / PAYMENTS
// ─────────────────────────────────────────────────────────────────────────

// Verified: two creation paths —
//  (1) shop/register.php: online self-registration (has password, customer_type='online')
//  (2) admin/ecommerce/billing.php / customers.php: walk-in creation (customer_type='offline', no password)
model EcomCustomer {
  id           Int      @id @default(autoincrement())
  name         String
  email        String?  @unique
  phone        String?
  password     String?  // only set for customer_type = "online"
  customerType String   @map("customer_type") // "online" | "offline"
  address      String?  @db.Text
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  orders    EcomOrder[]
  wishlist  EcomWishlist[]
  credits   EcomCredit[]
  addresses EcomCustomerAddress[]

  @@map("ecom_customers")
}

// Verified from admin/ecommerce/billing.php checkout logic.
// order_type distinguishes storefront ("online") vs POS ("offline") sales.
model EcomOrder {
  id              Int      @id @default(autoincrement())
  orderNumber     String   @unique @map("order_number")
  customerId      Int?     @map("customer_id")
  customerName    String   @map("customer_name")
  customerEmail   String?  @map("customer_email")
  isGuest         Boolean  @default(false) @map("is_guest")
  shippingAddress String?  @map("shipping_address") @db.Text
  shippingLat     Decimal? @map("shipping_lat") @db.Decimal(10, 7) // pinned location from the saved address (for delivery)
  shippingLng     Decimal? @map("shipping_lng") @db.Decimal(10, 7)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(10, 2)
  paidAmount      Decimal  @default(0) @map("paid_amount") @db.Decimal(10, 2)
  subtotalAmount  Decimal  @map("subtotal_amount") @db.Decimal(10, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  gstAmount       Decimal  @map("gst_amount") @db.Decimal(10, 2)
  paymentStatus   String   @map("payment_status") // "Paid" | "Unpaid"
  paymentMethod   String   @map("payment_method")  // "Cash" | "Card" | "UPI" | "Other" | "Split"
  orderStatus     String   @default("Pending") @map("order_status") // "Pending" | "In Progress" | "Delivered" | "Canceled"
  orderType       String   @map("order_type") // "online" (storefront) | "offline" (POS)
  createdAt       DateTime @default(now()) @map("created_at")

  customer EcomCustomer?      @relation(fields: [customerId], references: [id])
  items    EcomOrderItem[]
  payments EcomOrderPayment[]
  credits  EcomCredit[]

  @@map("ecom_orders")
}

// Verified: price/gst/hsn are SNAPSHOT at time of sale (not live product
// reference) — this is intentional so historical orders stay accurate
// even if the product's price changes later.
model EcomOrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int     @map("order_id")
  productId   Int     @map("product_id")
  productName String  @map("product_name") // snapshot
  hsnCode     String? @map("hsn_code")     // snapshot
  qty         Int
  price       Decimal @db.Decimal(10, 2)    // unit price at sale time (snapshot)
  gstRate     Decimal @map("gst_rate") @db.Decimal(5, 2)
  gstAmount   Decimal @map("gst_amount") @db.Decimal(10, 2)

  order   EcomOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product EcomProduct @relation(fields: [productId], references: [id])

  @@map("ecom_order_items")
}

// Supports split payments — one order can have multiple payment rows
// (e.g. ₹500 Cash + ₹300 UPI for one sale).
model EcomOrderPayment {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  paymentMethod String   @map("payment_method") // "Cash" | "Card" | "UPI" | "Other"
  amount        Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  order EcomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("ecom_order_payments")
}

// Verified from admin/ecommerce/coupons.php.
// applies_to determines which of product_id/category_id/subcategory_id is used.
model EcomCoupon {
  id               Int      @id @default(autoincrement())
  title            String
  code             String   @unique
  numberOfTimes    Int      @map("number_of_times") // usage limit
  usedCount        Int      @default(0) @map("used_count")
  discountType     String   @map("discount_type") // "percentage" | "fixed"
  discountValue    Decimal  @map("discount_value") @db.Decimal(10, 2)
  appliesTo        String   @map("applies_to") // "all" | "product" | "category" | "subcategory"
  productId        Int?     @map("product_id")
  categoryId       Int?     @map("category_id")
  subcategoryId    Int?     @map("subcategory_id")
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  startsAt         DateTime? @map("starts_at") // coupons2 — see prisma/coupons2.sql
  endsAt           DateTime? @map("ends_at")   // coupons2
  isPaused         Boolean  @default(false) @map("is_paused") // coupons2

  product      EcomProduct?     @relation("CouponProduct", fields: [productId], references: [id])
  category     EcomCategory?    @relation("CouponCategory", fields: [categoryId], references: [id])
  subcategory  EcomSubcategory? @relation("CouponSubcategory", fields: [subcategoryId], references: [id])

  @@map("ecom_coupons")
}

// Auto-created whenever a POS/online sale isn't paid in full.
// Verified from billing.php: "Auto-create a Due (credit) record".
model EcomCredit {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  customerId    Int?     @map("customer_id")
  customerName  String   @map("customer_name")
  customerPhone String?  @map("customer_phone")
  amount        Decimal  @db.Decimal(10, 2)
  // Verified from admin/dashboard.php: `SUM(amount - amount_paid)` is used to compute
  // outstanding "Due Promise" — this running total is denormalized here (kept in sync
  // whenever a EcomCreditPayment row is created) rather than summed on every read.
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(10, 2)
  promisedDate  DateTime? @map("promised_date")
  status        String   @default("pending") // "pending" | "paid" | "partial"
  createdAt     DateTime @default(now()) @map("created_at")

  order    EcomOrder     @relation(fields: [orderId], references: [id])
  customer EcomCustomer? @relation(fields: [customerId], references: [id])
  payments EcomCreditPayment[]

  @@map("ecom_credits")
}

model EcomCreditPayment {
  id             Int      @id @default(autoincrement())
  creditId       Int      @map("credit_id")
  receiptNumber  String   @map("receipt_number") // verified from due.php/record-due-payment.php — can be shared across multiple credits when "combine_receipt" is used
  amount         Decimal  @db.Decimal(10, 2)
  paymentMethod  String   @map("payment_method") // "Cash" | "Card" | "UPI" | "Other" (renamed from "method" to match the actual column name)
  createdBy      Int?     @map("created_by")     // admin user who recorded the payment
  createdAt      DateTime @default(now()) @map("created_at")

  credit EcomCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@map("ecom_credit_payments")
}

model EcomWishlist {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  productId  Int      @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer EcomCustomer @relation(fields: [customerId], references: [id])
  product  EcomProduct  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
  @@map("ecom_wishlist")
}

// ─────────────────────────────────────────────────────────────────────────
// ECOMMERCE — SETTINGS / HOMEPAGE BUILDER
// ─────────────────────────────────────────────────────────────────────────

// Single-row settings table (business info + POS config).
// JSON fields verified: contact_numbers, invoice_contact_numbers, social_media_json.
// POS settings verified from billing.php: pos_print_mode, printer_format, keyboard shortcuts.
model EcomBusinessSettings {
  id                     Int     @id @default(autoincrement())
  businessName           String  @map("business_name")
  tagline                String?
  seoDescription         String? @map("seo_description") @db.Text
  address                String? @db.Text
  location               String?
  phone                  String? // first entry of contactNumbers, kept denormalized to match the PHP's $phone column
  contactNumbers         Json?   @map("contact_numbers")          // JSON array of strings
  invoiceContactNumbers  Json?   @map("invoice_contact_numbers")  // JSON array — subset of contactNumbers chosen for invoices
  email                  String?
  websiteUrl             String? @map("website_url")
  businessHours          String? @map("business_hours")
  gstin                  String?
  panNumber              String? @map("pan_number")
  fssaiNumber            String? @map("fssai_number")
  state                  String?
  showGstinOnInvoice     Boolean @default(false) @map("show_gstin_on_invoice")
  showPanOnInvoice       Boolean @default(false) @map("show_pan_on_invoice")
  showFssaiOnInvoice     Boolean @default(false) @map("show_fssai_on_invoice")
  showAddressOnInvoice   Boolean @default(false) @map("show_address_on_invoice")
  showLocationOnInvoice  Boolean @default(false) @map("show_location_on_invoice")
  siteHeaderDisplay      String  @default("both") @map("site_header_display") // "title" | "logo" | "both"
  invoiceDisplay         String  @default("both") @map("invoice_display")     // "logo" | "name" | "both"
  invoiceTitle           String  @default("Tax Invoice") @map("invoice_title")
  invoiceFooterNote      String? @map("invoice_footer_note") @db.Text
  returnPolicy           String? @map("return_policy") @db.Text
  barcodeFooterText      String? @map("barcode_footer_text")
  orderIdPrefix          String  @default("ORD") @map("order_id_prefix")
  orderSequenceNext      Int     @default(1) @map("order_sequence_next")   // verified from generateOrderNumber() in functions.php
  receiptSequenceNext    Int     @default(1) @map("receipt_sequence_next") // verified from generateReceiptNumber() in functions.php
  logoDisplayWidth       Int     @default(150) @map("logo_display_width") // clamped 40-400 in the PHP form
  socialMediaJson        Json?   @map("social_media_json") // JSON array of {platform, url}
  logo                   String?

  // POS / billing configuration (verified from billing.php + business-settings.php)
  posPrintMode           String  @default("both") @map("pos_print_mode")      // "thermal" | "a4" | "both"
  printerFormat          String  @default("a4") @map("printer_format")        // "a4" | "thermal_58" | "thermal_80"
  shortcutCompleteSale   String  @default("F2") @map("shortcut_complete_sale") // any of F2-F12
  shortcutPrint          String  @default("F3") @map("shortcut_print")
  shortcutNewSale        String  @default("F4") @map("shortcut_new_sale")

  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("ecom_business_settings")
}

model EcomPaymentSettings {
  id        Int     @id @default(autoincrement())
  methodKey String  @unique @map("method_key") // "cod" | "paytm" | "phonepe" | "razorpay" | "bank_transfer"
  name      String
  image     String?
  text      String? @db.Text // customer-facing instructions/description for this method
  config    Json?           // arbitrary key-value pairs (API keys, UPI ID, bank details, etc.)
  isEnabled Boolean @default(false) @map("is_enabled")
  isDefault Boolean @default(false) @map("is_default") // payment-settings2 — see prisma/payment-settings2.sql

  @@map("ecom_payment_settings")
}

model EcomHomeSlide {
  id         Int     @id @default(autoincrement())
  image      String
  buttonLink String  @default("#") @map("button_link")
  sortOrder  Int     @default(0) @map("sort_order")
  status     String  @default("active")

  @@map("ecom_home_slides")
}

// Verified from homepage-settings.php's add_section action — section_type is one of
// "category_row" | "product_grid" | "festive_banner" | "manual_products", and the
// fields actually used vary a lot by type (a festive_banner has banner_text/
// banner_image, a category_row/product_grid has source_type/product_limit, etc.)
model EcomHomeSection {
  id           Int     @id @default(autoincrement())
  sectionType  String  @map("section_type") // "category_row" | "product_grid" | "festive_banner" | "manual_products"
  title        String?
  categoryId   Int?    @map("category_id")   // used when sourceType = "category"
  sourceType   String  @default("latest") @map("source_type") // "manual" | "category" | "latest"
  cardDesign   String  @default("design1") @map("card_design") // "design1".."design4" — a storefront visual style, not a DB shape
  productLimit Int     @default(10) @map("product_limit")
  bannerText   String? @map("banner_text")
  bannerImage  String? @map("banner_image") // only used when sectionType = "festive_banner"
  dismissible  Boolean @default(false)
  sortOrder    Int     @default(0) @map("sort_order")
  status       String  @default("active")

  category EcomCategory?          @relation(fields: [categoryId], references: [id])
  items    EcomHomeSectionItem[]

  @@map("ecom_home_sections")
}

// Verified from the add_section_item action — a single item can reference EITHER a
// category OR a product (whichever fits the parent section's purpose), or neither
// and just be a fully custom card (custom_label + custom_image), unlike the earlier
// schema's product-only assumption.
model EcomHomeSectionItem {
  id           Int     @id @default(autoincrement())
  sectionId    Int     @map("section_id")
  categoryId   Int?    @map("category_id")
  productId    Int?    @map("product_id")
  customLabel  String? @map("custom_label")
  customImage  String? @map("custom_image")
  sortOrder    Int     @default(0) @map("sort_order")

  section  EcomHomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category EcomCategory?   @relation(fields: [categoryId], references: [id])
  product  EcomProduct?    @relation(fields: [productId], references: [id])

  @@map("ecom_home_section_items")
}

model EcomHomeCategoryStrip {
  id         Int @id @default(autoincrement())
  categoryId Int @map("category_id")
  sortOrder  Int @default(0) @map("sort_order")

  category EcomCategory @relation(fields: [categoryId], references: [id])

  @@map("ecom_home_category_strip")
}

// Verified: a generic key-value settings bag (category_strip_mode,
// category_strip_count, and potentially more in the future) — NOT a single-row
// settings table like EcomBusinessSettings.
model EcomHomeSetting {
  id           Int    @id @default(autoincrement())
  settingKey   String @unique @map("setting_key")
  settingValue String @map("setting_value")

  @@map("ecom_home_settings")
}

// ─────────────────────────────────────────────────────────────────────────
// BLOG / CONTENT / JOB-PORTAL
// ─────────────────────────────────────────────────────────────────────────

model Author {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  bio   String? @db.Text
  image String?

  posts Post[]

  @@map("authors")
}

model StateEntry {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  posts Post[]

  @@map("states")
}

model BlogCategory {
  id     Int    @id @default(autoincrement())
  name   String
  slug   String @unique
  status String @default("active")

  posts PostCategory[]

  @@map("categories")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  posts PostTag[]

  @@map("tags")
}

// Verified fields include faq_json (FAQ blocks stored as JSON on the post).
model Post {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  content         String    @db.Text
  faqJson         Json?     @map("faq_json") // array of {question, answer}
  lastDate        DateTime? @map("last_date") // e.g. application deadline for job posts
  authorId        Int?      @map("author_id")
  stateId         Int?      @map("state_id")
  categoryId      Int?      @map("category_id") // primary category shortcut, in addition to the M:N table below
  status          String    @default("draft")   // "draft" | "published" | "archived"
  publishAt       DateTime? @map("publish_at")
  featuredImageId Int?      @map("featured_image_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdByUserId Int?     @map("created_by_user_id")

  author        Author?        @relation(fields: [authorId], references: [id])
  state         StateEntry?    @relation(fields: [stateId], references: [id])
  featuredImage Media?         @relation(fields: [featuredImageId], references: [id])
  createdByUser User?          @relation(fields: [createdByUserId], references: [id])
  categories    PostCategory[]
  tags          PostTag[]
  meta          PostMeta[]
  comments      Comment[]
  views         PostView[]
  pushCampaigns PushCampaign[] // push-manager2

  @@map("posts")
}

model PostCategory {
  postId     Int @map("post_id")
  categoryId Int @map("category_id")

  post     Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  category BlogCategory @relation(fields: [categoryId], references: [id])

  @@id([postId, categoryId])
  @@map("post_categories")
}

model PostTag {
  postId Int @map("post_id")
  tagId  Int @map("tag_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
  @@map("post_tag")
}

model PostMeta {
  id     Int    @id @default(autoincrement())
  postId Int    @map("post_id")
  key    String
  value  String @db.Text

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, key])
  @@map("post_meta")
}

// Verified: triggers CommentMailer notification email on new comment.
model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  parentId  Int?     @map("parent_id") // for threaded replies
  authorName String  @map("author_name")
  authorEmail String @map("author_email")
  content   String   @db.Text
  status    String   @default("pending") // "pending" | "approved" | "spam"
  createdAt DateTime @default(now()) @map("created_at")

  post   Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

model PostView {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  ipAddress String?  @map("ip_address")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  post Post @relation(fields: [postId], references: [id])

  @@map("post_views")
}

model PostStatsDaily {
  id    Int      @id @default(autoincrement())
  postId Int     @map("post_id")
  date  DateTime @db.Date
  views Int      @default(0)

  @@unique([postId, date])
  @@map("post_stats_daily")
}

model VisitorLog {
  id        Int      @id @default(autoincrement())
  ipAddress String   @map("ip_address")
  userAgent String?  @map("user_agent")
  path      String
  visitedAt DateTime @default(now()) @map("visited_at")

  @@map("visitor_log")
}

model AdBlock {
  id       Int    @id @default(autoincrement())
  name     String
  slot     String // e.g. "sidebar", "in-article", "header"
  codeHtml String @map("code_html") @db.Text // raw ad script/HTML
  status   String @default("active")

  @@map("ad_blocks")
}

model Media {
  id             Int      @id @default(autoincrement())
  filePath       String   @map("file_path") // verified from file-manager.php — relative path from doc root, e.g. "uploads/foo_64f2a1.jpg"
  fileType       String   @map("file_type") // "image" | "pdf" | "video" | "audio" | "document" | "archive" | "other"
  altText        String?  @map("alt_text")
  title          String?  @default("")
  caption        String?  @db.Text
  description    String?  @db.Text
  responsiveSet  Json?    @map("responsive_set") // JSON array of resized-variant paths, for images
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  posts Post[]

  @@map("media")
}

// Generic static-content page (About Us, Privacy Policy, Terms, Contact, etc.) —
// a simple, standalone CMS page system, independent of the (out-of-scope) blog
// module. Each page is just a slug + title + rich-text body + basic SEO fields.
model Page {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  content         String   @db.Text
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  status          String   @default("published") // "draft" | "published"
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model TableTemplate {
  id      Int    @id @default(autoincrement())
  name    String
  content String @db.Text

  @@map("table_templates")
}

// ─────────────────────────────────────────────────────────────────────────
// PUSH NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────

model PushSubscription {
  id        Int      @id @default(autoincrement())
  // MySQL cannot put a unique index on a `Text` column without an explicit
  // key-prefix length (Postgres has no such restriction, which is why this
  // worked before switching providers). Push subscription endpoint URLs are
  // well under 768 chars in practice, and 768 bytes is safely within MySQL's
  // max index key length (3072 bytes for InnoDB w/ utf8mb4, 4 bytes/char).
  endpoint  String   @unique @db.VarChar(768)
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model PushCampaign {
  id               Int      @id @default(autoincrement())
  postId           Int?     @map("post_id") // push-manager2 — see prisma/push-manager2.sql
  title            String
  body             String
  url              String?
  icon             String?
  image            String?  // push-manager2 — banner shown in the notification, distinct from icon
  status           String   @default("draft") // "draft" | "pending" | "processing" | "completed" | "failed"
  totalSubscribers Int?     @default(0) @map("total_subscribers") // push-manager2
  sent             Int?     @default(0) // push-manager2
  failed           Int?     @default(0) // push-manager2
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at") // push-manager2

  queueItems PushQueue[]
  post       Post?    @relation(fields: [postId], references: [id]) // push-manager2

  @@map("push_campaigns")
}

model PushQueue {
  id             Int      @id @default(autoincrement())
  campaignId     Int      @map("campaign_id")
  subscriptionId Int      @map("subscription_id")
  status         String   @default("pending") // "pending" | "sent" | "failed"
  attemptedAt    DateTime? @map("attempted_at")
  attempts       Int?     @default(0) // push-manager2
  lastError      String?  @map("last_error") @db.Text // push-manager2

  campaign PushCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("push_queue")
}

// ─────────────────────────────────────────────────────────────────────────
// CAMPAIGNS (Campaign Offer 2)
// Additive only: three NEW tables, no existing table or column is changed.
// A campaign discounts products for a period — all products, some
// categories, some brands, or hand-picked products. The price is worked out
// by src/lib/campaign-core.ts and applied in the shop and in billing; the
// sales it makes are recorded in ecom_campaign_sales for the reports.
// The older per-product "campaign price" on ecom_products is untouched and
// is NOT used by the shop or billing.
// ─────────────────────────────────────────────────────────────────────────

model EcomCampaign {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(150)
  scope         String    @db.VarChar(20)                        // "all" | "category" | "brand" | "product"
  discountType  String    @map("discount_type") @db.VarChar(20)  // "percent" | "amount" | "fixed"
  discountValue Decimal?  @map("discount_value") @db.Decimal(10, 2) // % or ₹ off; empty for "fixed" (each product has its own price)
  startsAt      DateTime? @map("starts_at")                      // empty = starts immediately
  endsAt        DateTime? @map("ends_at")                        // empty = no end date
  isPaused      Boolean   @default(false) @map("is_paused")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  targets EcomCampaignTarget[]
  sales   EcomCampaignSale[]

  @@index([isPaused, startsAt, endsAt])
  @@map("ecom_campaigns")
}

/// What a campaign applies to (empty for scope "all").
model EcomCampaignTarget {
  id         Int      @id @default(autoincrement())
  campaignId Int      @map("campaign_id")
  targetType String   @map("target_type") @db.VarChar(20) // "category" | "brand" | "product"
  targetId   Int      @map("target_id")
  fixedPrice Decimal? @map("fixed_price") @db.Decimal(10, 2) // only for discountType "fixed" (product targets)

  campaign EcomCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("ecom_campaign_targets")
}

/// One row per order line that was sold at a campaign price. Written after the
/// sale is saved (never inside it), so it can never hold up a checkout.
/// order/product are plain ids (no foreign keys) so nothing else is affected.
model EcomCampaignSale {
  id              Int      @id @default(autoincrement())
  campaignId      Int      @map("campaign_id")
  orderId         Int      @map("order_id")
  orderItemId     Int      @unique @map("order_item_id")
  productId       Int      @map("product_id")
  qty             Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2)          // what the customer paid per unit
  discountPerUnit Decimal  @map("discount_per_unit") @db.Decimal(10, 2)   // how much less than the price they'd otherwise have paid
  createdAt       DateTime @default(now()) @map("created_at")

  campaign EcomCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([orderId])
  @@map("ecom_campaign_sales")
}

/// Storefront configuration from Business Settings (menus, menu design, push
/// prompt/bell, footer) — one JSON document per key. See src/lib/storefront-config.ts
/// and prisma/storefront-settings.sql.
model StorefrontSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("storefront_settings")
}

/// Saved delivery addresses (storefront account + checkout). See prisma/customer-addresses.sql.
model EcomCustomerAddress {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  name       String   @db.VarChar(100)
  phone      String   @db.VarChar(20)
  pincode    String   @db.VarChar(10)
  state      String   @db.VarChar(60)
  city       String   @db.VarChar(80)
  house      String   @db.VarChar(200) // house no. / building
  area       String   @db.VarChar(200) // road / area / colony
  landmark   String?  @db.VarChar(150) // nearby
  type       String   @default("home") @db.VarChar(10) // home | work | other
  lat        Decimal? @db.Decimal(10, 7)
  lng        Decimal? @db.Decimal(10, 7)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer EcomCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("ecom_customer_addresses")
}
