# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/edumint24"

# ── Auth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-fresh-random-secret-here"
# Admin/staff JWT secret (kept separate from customer auth on purpose —
# the original PHP app used two entirely separate login systems)
ADMIN_JWT_SECRET="generate-a-fresh-random-secret-here"
CUSTOMER_JWT_SECRET="generate-a-fresh-random-secret-here"

# ── App identity (was APP_NAME / SITE_URL / CONTACT_EMAIL in config.php) ──
NEXT_PUBLIC_APP_NAME="EduMint24"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"
NEXT_PUBLIC_SEO_DEFAULT_TITLE="EduMint24"

# ── Email (replaces PHPMailer used by mailers/CommentMailer.php) ──────────
RESEND_API_KEY="generate-fresh-key-in-resend-dashboard"
EMAIL_FROM="notifications@example.com"

# ── Web Push (replaces minishlink/web-push VAPID keys) ─────────────────────
# Generate fresh keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="generate-fresh-vapid-key"
VAPID_PRIVATE_KEY="generate-fresh-vapid-key"
VAPID_SUBJECT="mailto:contact@example.com"

# ── File uploads ────────────────────────────────────────────────────────────
# "local" writes to /public/uploads (dev only); use "s3" in production
UPLOAD_STRATEGY="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Cron protection (for /api/cron/* routes) ───────────────────────────────
CRON_SECRET="generate-a-fresh-random-secret-here"
