{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The admin website inside the app: native notifications, taskbar attention, window title, app version, opening links in the browser.",
  "windows": ["main"],
  "remote": { "urls": ["https://sriandaltraders.co.in", "https://*.sriandaltraders.co.in"] },
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:app:allow-version",
    "notification:default",
    "opener:default",
    "opener:allow-open-url"
  ]
}
